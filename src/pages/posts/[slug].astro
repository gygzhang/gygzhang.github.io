---
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const posts = await getCollection('posts', ({ data }) => data.visibility === 'public'); return posts.map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
---
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{post.data.title} · gygzhang</title></head><body><header><a class="brand" href="/">gygzhang</a><a href="/posts/">← 全部文章</a></header><main><article><p class="meta">{post.data.date.toISOString().slice(0, 10)}</p><h1>{post.data.title}</h1><div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div><div class="content"><Content /></div><section class="comments"><h2>评论</h2><script src="https://giscus.app/client.js" data-repo="gygzhang/gygzhang.github.io" data-repo-id="MDEwOlJlcG9zaXRvcnkzOTUxODAzNzQ=" data-category="Announcements" data-category-id="DIC_kwDOF435Vs4DFtoX" data-mapping="pathname" data-strict="0" data-reactions-enabled="1" data-emit-metadata="0" data-input-position="top" data-theme="dark_tritanopia" data-lang="zh-CN" data-loading="lazy" crossorigin="anonymous" async></script></section></article></main><footer>© 2025 gygzhang · 公开技术笔记</footer></body></html>
<style is:global>:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans SC",sans-serif;color:#202124;background:#f7f7f5}body{margin:0}header{max-width:900px;margin:auto;padding:28px;display:flex;justify-content:space-between}header a{color:#777;text-decoration:none}.brand{font-weight:800;color:#202124!important}main{max-width:900px;margin:70px auto;padding:0 28px}article{max-width:720px;margin:auto}.meta{color:#788078;font-size:.9rem}h1{font-size:clamp(2.6rem,7vw,5rem);line-height:1.05;letter-spacing:-.07em;margin:22px 0}.tags{display:flex;gap:8px}.tags span{font-size:.75rem;color:#667766;background:#e7eee7;padding:5px 9px;border-radius:3px}.content{margin-top:48px}.content p{line-height:2;font-size:1.05rem}.content pre{background:#202124;color:#eee;padding:18px;overflow:auto;border-radius:5px}.content code{font-family:ui-monospace,monospace}.comments{border-top:1px solid #ddd;margin-top:70px;padding-top:25px}.comments h2{margin-bottom:18px}footer{max-width:900px;margin:auto;padding:30px 28px;color:#999;font-size:.8rem}</style>
